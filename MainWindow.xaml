<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteGallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CelesteGallery.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CelesteGallery">

    <!--
      窗口这一层只当一个"舞台"：装浏览页，单图页按需动态加进来。

      单图页为什么不写在 XAML 里？因为它 Loaded 时会把标题栏接管过去，
      而两个页面同时存在时会互相覆盖。动态创建就只在真正要显示时才发生这件事。
    -->
    <Grid x:Name="Host">
        <views:BrowserPage x:Name="Browser" />
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CelesteGallery.Views.BrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CelesteGallery.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <!--
      缩略图格子模板：主墙（Thumbs）和"查找重复"模式里每个重复组的格子共用同一套。
      放 Resources 是为了让代码里 new 出来的嵌套 ItemsRepeater 也能引用，
      不用在 C# 里用 XamlReader 拼模板。
    -->
    <Page.Resources>
        <DataTemplate x:Key="TileTemplate" x:DataType="views:ThumbnailItem">
            <Grid Margin="3"
                  Background="#FF202020"
                  CornerRadius="6"
                  Tapped="Thumb_Tapped"
                  DoubleTapped="Thumb_DoubleTapped"
                  ContextRequested="Thumb_ContextRequested">

                <!-- 缩略图本体 -->
                <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                       Stretch="Uniform"
                       Margin="7,7,7,26"/>

                <!-- 还没解出来时的占位 -->
                <FontIcon Glyph="&#xEB9F;"
                          FontSize="26"
                          Foreground="#33FFFFFF"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}"/>

                <!-- 解不出来时的提示 -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Visibility="{x:Bind FailedVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE783;" FontSize="22" Foreground="#77FF8080"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="打不开" FontSize="11" Foreground="#99FF8080"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 文件名 -->
                <Border VerticalAlignment="Bottom"
                        Background="#B3000000"
                        CornerRadius="0,0,6,6"
                        Padding="8,4"
                        IsHitTestVisible="False">
                    <TextBlock Text="{x:Bind FileName}"
                               FontSize="11"
                               Foreground="#CCFFFFFF"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!--
                  来自子文件夹时的角标。只有开了"包含子文件夹"、
                  而且这张图确实在子目录里才出现。
                -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#CC000000"
                        CornerRadius="6,0,6,0"
                        Padding="6,2"
                        MaxWidth="150"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind SubFolderVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind SubFolder}"
                               FontSize="10"
                               Foreground="#BBFFFFFF"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- 多选勾选角标：右上角蓝圆 + 白勾 -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,6,0"
                        Width="22" Height="22"
                        CornerRadius="11"
                        Background="#FF4DA3FF"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind MultiSelectedVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="12"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>

                <!--
                  "保留"角标：只在"查找重复"模式里、且这张被标记为保留时出现，
                  压在文件名条上方、左下角，方便一眼看出"这一组里留哪张"。
                -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        Background="#CC1F7A33"
                        CornerRadius="6,0,6,0"
                        Padding="6,2"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind KeepBadgeVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="保留" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 选中框：用不透明度切换，不给每个格子分配画刷 -->
                <Border BorderBrush="#FF4DA3FF"
                        BorderThickness="2"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Opacity="{x:Bind SelectionOpacity, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--
      浏览界面（路线图第 3 步）：左边目录树，右边缩略图墙。
      布局上刻意用"悬浮"而不是"分栏加分隔条"：
      左边树固定宽度，不抢镜；用户想看大图时双击格子进单图页。
    -->
    <Grid x:Name="Root" Background="#FF151515">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题栏：整条可拖动窗口 ===== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <!-- 应用图标 + 应用名常驻；后面跟当前文件夹名 -->
                <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="CelesteGallery" FontSize="13" FontWeight="SemiBold"
                           Foreground="#EEFFFFFF" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleDot" Text="·" FontSize="13" Foreground="#44FFFFFF"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="TitleText" Text="" FontSize="13"
                           Foreground="#88FFFFFF" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ===== 主体：左树右墙 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧目录树 -->
            <Border x:Name="TreePane"
                    Grid.Column="0"
                    Width="236"
                    Background="#FF1B1B1B"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 包含子文件夹 -->
                        <RowDefinition Height="Auto"/>   <!-- 分类维度 + 搜索 -->
                        <RowDefinition Height="Auto"/>   <!-- 「图库」标题 -->
                        <RowDefinition Height="*"/>      <!-- 目录树 -->
                        <RowDefinition Height="Auto"/>   <!-- 关于 -->
                    </Grid.RowDefinitions>

                    <!--
                      "包含子文件夹"开关。

                      为什么需要它：照片常常按 2026\09 这样一层层分目录存，
                      点父目录时如果只看它自己那一层，用户会觉得"图没了"。
                      打开就变成"当前目录 + 下面所有子目录"一起铺出来。

                      默认关着 —— 因为递归扫大目录是要花时间的，
                      不该在用户没要求的时候擅自去扫。

                      放在最上面而不是最下面：它是"这一屏显示什么"的总开关，
                      跟它作用的目录树挨得越近越好懂；最下面留给"关于"这种
                      跟看图无关的东西。
                    -->
                    <Border x:Name="IncludeSubRow"
                            Grid.Row="0"
                            Background="#FF171717"
                            BorderBrush="#1AFFFFFF"
                            BorderThickness="0,0,0,1"
                            Padding="10,7,8,7">
                        <ToggleSwitch x:Name="IncludeSubSwitch"
                                      Toggled="IncludeSubSwitch_Toggled"
                                      OffContent="包含子文件夹"
                                      OnContent="包含子文件夹"
                                      FontSize="12"
                                      MinWidth="0"
                                      ToolTipService.ToolTip="把当前文件夹下面所有子文件夹里的图片也一起铺出来"/>
                    </Border>

                    <!--
                      分类维度 + 搜索。

                      这一排是"图库管理"和"单纯看图"的分界线：
                      以前左树只能按文件夹分，想按日期/相机找图只能靠记路径。
                      现在换维度只换树的内容 —— 外壳、右键菜单、多选全都不用动，
                      以后加"标签""智能相册"也只是往这个 ComboBox 里多塞一项。

                      判据放在 Tag 上而不是按顺序取 SelectedIndex：
                      以后调整选项顺序、或者临时隐藏某一项，都不会把分类串位。
                    -->
                    <StackPanel Grid.Row="1" Margin="10,9,10,2" Spacing="7">
                        <ComboBox x:Name="GroupCombo"
                                  HorizontalAlignment="Stretch"
                                  FontSize="12.5"
                                  SelectionChanged="GroupCombo_SelectionChanged"
                                  ToolTipService.ToolTip="左侧这棵树按什么来分。按日期时，照片用拍摄时间，没有拍摄时间的（截图、聊天里的图）用文件修改时间。">
                            <ComboBoxItem Content="按文件夹" Tag="Folder" IsSelected="True"/>
                            <ComboBoxItem Content="按日期" Tag="Date"/>
                            <ComboBoxItem Content="按相机" Tag="Camera"/>
                            <ComboBoxItem Content="按镜头" Tag="Lens"/>
                            <ComboBoxItem Content="按评分" Tag="Rating"/>
                            <!-- 来源 = 这张图从哪来：微信 / QQ / 企业微信 / 本地。
                                 值在建立索引时按路径算好（见 SocialCacheDetector）。 -->
                            <ComboBoxItem Content="按来源" Tag="Source"/>
                        </ComboBox>

                        <!--
                          不给 ItemsSource，所以它不会弹建议列表，就是个带搜索图标
                          和清除按钮的输入框（比 TextBox 省得自己画这两个东西）。
                        -->
                        <!--
                          用 AutoSuggestBox 而不是 TextBox：白送一个放大镜图标和
                          一键清除的 ×。
                          建议列表用来放标签：敲几个字，图库里已有的标签出现在下面，
                          点一个就按标签筛（不用记自己起过哪些名字）。
                          UpdateTextOnSelect 必须关掉 —— 默认会把选中项的文字填回输入框，
                          那样"框里的字"和"正在生效的筛选"就成两笔账了。
                          注意别写 QueryIcon="Find" —— WinUI3 里它是 IconElement，
                          塞字符串会让 XamlCompiler 内部空引用崩（报错落在 .targets 上，
                          看不出是这一行的锅），默认的放大镜本来就是 Find。
                        -->
                        <AutoSuggestBox x:Name="SearchBox"
                                        PlaceholderText="搜索文件名 / 相机 / 镜头 / 标签"
                                        FontSize="12.5"
                                        UpdateTextOnSelect="False"
                                        TextChanged="SearchBox_TextChanged"
                                        QuerySubmitted="SearchBox_QuerySubmitted"/>

                        <!--
                          社交缓存提示条：探测到本机有微信 / QQ / 企业微信 的缓存图、
                          但还没收进图库时出现。点"加入图库"把这些目录收进来，
                          之后用上面的"按来源"就能统一浏览。

                          为什么做成"提示 + 一键"而不是自动收进来：
                          那是别人软件的数据目录，收不收该用户说了算 ——
                          有人并不想让聊天里的图混进自己的相册。
                          点叉之后不再出现（记在 settings 里）。
                        -->
                        <Border x:Name="SocialHint"
                                Visibility="Collapsed"
                                Background="#14FFFFFF"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,7">
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- E716 = 联系人，用来指代"来自社交软件" -->
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE716;"
                                          FontSize="13"
                                          Margin="0,1,0,0"
                                          VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="SocialHintText"
                                           FontSize="11.5"
                                           LineHeight="16"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="2"
                                        x:Name="SocialAddButton"
                                        Content="加入图库"
                                        Click="SocialAddButton_Click"
                                        FontSize="11.5"
                                        Padding="9,3"
                                        VerticalAlignment="Center"/>
                                <Button Grid.Column="3"
                                        x:Name="SocialHintClose"
                                        Click="SocialHintClose_Click"
                                        Width="24" Height="24"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="不再提示">
                                    <!-- E711 = 取消/叉 -->
                                    <FontIcon Glyph="&#xE711;" FontSize="11"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="16,10,10,4">
                        <TextBlock x:Name="TreeTitle" Text="图库" FontSize="14" Foreground="#8CFFFFFF"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                            <!--
                              "整理图库"：把图库里的目录收进索引库。
                              只有按日期/相机分类、或者用了搜索时才需要它 ——
                              按文件夹浏览是直接读磁盘的，压根不碰索引。
                              索引是增量的，整理过一次以后再点基本是秒完成。
                            -->
                            <Button x:Name="IndexButton"
                                    Click="IndexButton_Click"
                                    Width="30" Height="30" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="整理图库（建立日期 / 相机 / 搜索所需的索引）">
                                <!-- E72C = Refresh -->
                                <FontIcon Glyph="&#xE72C;" FontSize="15"/>
                            </Button>
                            <Button x:Name="AddFolderButton"
                                    Click="AddFolderButton_Click"
                                    Width="30" Height="30" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="添加文件夹到图库">
                                <!-- E710 = Add -->
                                <FontIcon Glyph="&#xE710;" FontSize="17"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--
                      目录树：根是"图库"，底下是用户收进来的文件夹。
                      对着条目右键可以移除、在资源管理器里打开、加入图库等（见代码里的 BuildFolderMenu）。
                      子目录仍然是懒展开，展开哪个读哪个。
                    -->
                    <TreeView x:Name="FolderTree"
                              Grid.Row="3"
                              SelectionMode="Single"
                              Expanding="FolderTree_Expanding"
                              ItemInvoked="FolderTree_ItemInvoked"
                              ContextRequested="FolderTree_ContextRequested">
                        <!-- 展开动画用代码在 FolderTree_Expanding 里加，避开 XamlCompiler 对 TreeView.ItemContainerTransitions 的崩溃 -->
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <!--
                                  ContextRequested 挂在这一层：DataContext 就是 TreeViewNode，
                                  比"从右键坐标去反查是哪个节点"可靠得多。
                                  点在这一行之外的空白处会冒泡到 TreeView 上，走另一个菜单。

                                  外层改成竖排，是为了让"社交缓存"那条分区标题
                                  能在自己头上压一条分隔线（普通条目的线是 Collapsed）。
                                  Visibility / Margin / FontSize 全部由模型直接给值，
                                  不引转换器 —— 一个模板同时伺候两种行。
                                -->
                                <StackPanel Loaded="FolderNode_Loaded"
                                            ContextRequested="FolderNode_ContextRequested"
                                            Margin="{Binding Content.SectionMargin}"
                                            ToolTipService.ToolTip="{Binding Content.Path}">
                                    <Border Height="1"
                                            Margin="0,0,0,7"
                                            HorizontalAlignment="Stretch"
                                            MinWidth="140"
                                            Background="#26FFFFFF"
                                            Visibility="{Binding Content.SectionDividerVisibility}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="{Binding Content.Glyph}" FontSize="18"
                                                  Foreground="#B4FFFFFF"/>
                                        <!--  DataContext 是 TreeViewNode，Content 是 FolderNode  -->
                                        <TextBlock Text="{Binding Content.Label}"
                                                   FontSize="{Binding Content.LabelFontSize}"
                                                   Foreground="#E2E2E2" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!--
                      左下角"关于" + "文件关联"。
                      两个都点一下弹一个小窗口，属于"偶尔看一眼/设一次"的东西，
                      放在最底部是想让它们安分待着 —— 不该和看图的操作混在一起。
                    -->
                    <Border Grid.Row="4"
                            Background="#FF171717"
                            BorderBrush="#1AFFFFFF"
                            BorderThickness="0,1,0,0"
                            Padding="10,8,6,9">
                        <Grid ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="AboutButton"
                                    Grid.Column="0"
                                    Click="AboutButton_Click"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Height="30"
                                    Padding="6,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="关于 CelesteGallery">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <!-- E946 = info -->
                                    <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="#B8FFFFFF"/>
                                    <TextBlock Text="关于" FontSize="13.5" Foreground="#DCE2E2E2"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="FileAssocButton"
                                    Grid.Column="1"
                                    Click="FileAssocButton_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Height="30"
                                    Padding="6,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="把图片格式的双击打开方式交给 CelesteGallery">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <!-- E8A5 = 链接，和 MusicPlayer 的关联窗口同一个图标 -->
                                    <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="#B8FFFFFF"/>
                                    <TextBlock Text="文件关联" FontSize="13.5" Foreground="#DCE2E2E2"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧：工具条 + 缩略图墙 + 状态栏 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 工具条 -->
                <Grid Grid.Row="0" Padding="16,10,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PathText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#88FFFFFF"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                                VerticalAlignment="Center">
                        <!--
                          左侧目录树只放"桌面 / 图片 / 下载"三个常用位置，不列磁盘
                          （磁盘根目录基本不会有照片，白占地方）。
                          放在别处的照片从这儿进去 —— 弹系统文件夹选择框，选完直接切过去。
                        -->
                        <!-- 选择：进入/退出多选状态 -->
                        <Button x:Name="SelectButton"
                                Click="SelectButton_Click"
                                Width="36" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="选择（多选）">
                            <FontIcon Glyph="&#xE73A;" FontSize="16"/>
                        </Button>

                        <!-- 幻灯片放映：用当前目录（或选中那张）开幻灯 -->
                        <Button x:Name="SlideButton"
                                Click="SlideButton_Click"
                                Width="36" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="幻灯片放映">
                            <FontIcon Glyph="&#xE786;" FontSize="16"/>
                        </Button>

                        <!-- 展示方式：布局（方形/等高）+ 大小（小/中/大） -->
                        <Button x:Name="ViewButton"
                                Width="36" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="展示方式（布局 + 缩略图大小）">
                            <!--
                              E890 = View（"看的方式"那个图标）。
                              之前用的是 E71E，那是 Zoom —— 一枚放大镜，
                              放在这里会让人以为点了是缩放，实际弹的是布局/大小菜单，对不上。
                            -->
                            <FontIcon Glyph="&#xE890;" FontSize="16"/>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="12" Padding="4">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="布局" FontSize="12"
                                                       Foreground="#99FFFFFF"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ToggleButton x:Name="LayoutSquareToggle"
                                                             Content="方形"
                                                             IsChecked="True"
                                                             Checked="LayoutSquareToggle_Checked"
                                                             Unchecked="LayoutSquareToggle_Unchecked"/>
                                                <ToggleButton x:Name="LayoutUniformToggle"
                                                             Content="等高"
                                                             Checked="LayoutUniformToggle_Checked"
                                                             Unchecked="LayoutUniformToggle_Unchecked"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="大小" FontSize="12"
                                                       Foreground="#99FFFFFF"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ToggleButton x:Name="SizeSmallToggle"
                                                             Content="小" Tag="140"
                                                             Checked="SizePresetToggle_Checked"
                                                             Unchecked="SizePresetToggle_Unchecked"/>
                                                <ToggleButton x:Name="SizeMediumToggle"
                                                             Content="中" Tag="180" IsChecked="True"
                                                             Checked="SizePresetToggle_Checked"
                                                             Unchecked="SizePresetToggle_Unchecked"/>
                                                <ToggleButton x:Name="SizeLargeToggle"
                                                             Content="大" Tag="240"
                                                             Checked="SizePresetToggle_Checked"
                                                             Unchecked="SizePresetToggle_Unchecked"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!--
                          排序：只管右侧这一屏的顺序，不动左边的分组。
                          第一项"默认（跟随分类）"的意思是：按文件夹时按文件名排（和
                          资源管理器一个顺序），按日期/相机/镜头时按拍摄时间倒序排 ——
                          也就是加这个功能之前的行为。
                        -->
                        <Button x:Name="SortButton"
                                Width="36" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="排序方式">
                            <!-- E8CB = Sort（三条横线带箭头） -->
                            <FontIcon Glyph="&#xE8CB;" FontSize="16"/>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="10" Padding="4" MinWidth="196">
                                        <TextBlock Text="排序" FontSize="12"
                                                   Foreground="#99FFFFFF"/>
                                        <StackPanel Spacing="6">
                                            <ToggleButton x:Name="SortDefaultToggle"
                                                          Content="默认（跟随分类）"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Left"
                                                          Checked="SortToggle_Checked"
                                                          Unchecked="SortToggle_Unchecked"/>
                                            <ToggleButton x:Name="SortNameAscToggle"
                                                          Content="文件名　A → Z" Tag="FileNameAsc"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Left"
                                                          Checked="SortToggle_Checked"
                                                          Unchecked="SortToggle_Unchecked"/>
                                            <ToggleButton x:Name="SortNameDescToggle"
                                                          Content="文件名　Z → A" Tag="FileNameDesc"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Left"
                                                          Checked="SortToggle_Checked"
                                                          Unchecked="SortToggle_Unchecked"/>
                                            <ToggleButton x:Name="SortDateDescToggle"
                                                          Content="拍摄时间　新 → 旧" Tag="DateTakenDesc"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Left"
                                                          Checked="SortToggle_Checked"
                                                          Unchecked="SortToggle_Unchecked"/>
                                            <ToggleButton x:Name="SortDateAscToggle"
                                                          Content="拍摄时间　旧 → 新" Tag="DateTakenAsc"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Left"
                                                          Checked="SortToggle_Checked"
                                                          Unchecked="SortToggle_Unchecked"/>
                                            <ToggleButton x:Name="SortSizeDescToggle"
                                                          Content="文件大小　大 → 小" Tag="FileSizeDesc"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Left"
                                                          Checked="SortToggle_Checked"
                                                          Unchecked="SortToggle_Unchecked"/>
                                        </StackPanel>
                                        <TextBlock Text="按文件夹浏览时没有元数据可用，「拍摄时间」按文件的修改时间排。"
                                                   FontSize="11" Foreground="#66FFFFFF"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!--
                          只看收藏：第一个"智能相册"。
                          收藏只存在索引库里 —— 按文件夹直接扫盘那条路压根没这个概念，
                          所以在那种模式下打开它会自动切到按日期（跟在搜索框里打字一样）。
                        -->
                        <ToggleButton x:Name="FavToggle"
                                      Padding="10,5"
                                      VerticalAlignment="Center"
                                      ToolTipService.ToolTip="只看收藏的图"
                                      Checked="FavToggle_Checked"
                                      Unchecked="FavToggle_Unchecked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- E734 = FavoriteStar（空心星） -->
                                <FontIcon x:Name="FavIcon" Glyph="&#xE734;" FontSize="13"/>
                                <TextBlock Text="只看收藏" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>

                        <!--
                          查找重复：第二个"智能相册"。和"只看收藏"一样是 ToggleButton
                          （开着 = 进入查重视图）。默认按 MD5 找精确重复；
                          点开后用命令条里的"精确重复 / 相似图片"再切。
                        -->
                        <ToggleButton x:Name="DupToggle"
                                      Padding="10,5"
                                      VerticalAlignment="Center"
                                      ToolTipService.ToolTip="查找重复 / 相似的图片"
                                      Checked="DupToggle_Checked"
                                      Unchecked="DupToggle_Unchecked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- E8C8 = Copy（两份叠一起，最贴"重复"语义） -->
                                <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                                <TextBlock Text="查找重复" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>

                        <Button x:Name="OpenFolderButton"
                                Click="OpenFolderButton_Click"
                                ToolTipService.ToolTip="打开任意文件夹（比如放在 D 盘的照片）"
                                Padding="10,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <!-- E838 = FolderOpen -->
                                <FontIcon Glyph="&#xE838;" FontSize="13"/>
                                <TextBlock Text="打开文件夹" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="缩略图大小" FontSize="11" Foreground="#66FFFFFF"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="SizeSlider"
                                Width="130"
                                Minimum="110"
                                Maximum="300"
                                StepFrequency="10"
                                Value="180"
                                ValueChanged="SizeSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>

                <!-- 多选命令条：只有进了多选模式才出现 -->
                <Border x:Name="MultiSelectBar"
                        Grid.Row="1"
                        Background="#FF202020"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="0,0,0,1"
                        Padding="12,7"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="SelectAllButton"
                                Click="SelectAllButton_Click"
                                Padding="10,4"
                                ToolTipService.ToolTip="把这一屏的所有图都选上">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73A;" FontSize="13"/>
                                <TextBlock Text="全选" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearSelButton"
                                Click="ClearSelButton_Click"
                                Padding="10,4"
                                ToolTipService.ToolTip="取消全部已选">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="13"/>
                                <TextBlock Text="取消全选" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="SelCountText"
                                   Text="已选 0 张" FontSize="12"
                                   Foreground="#A6FFFFFF"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ExitMultiButton"
                                Click="ExitMultiButton_Click"
                                HorizontalAlignment="Right"
                                Padding="10,4"
                                ToolTipService.ToolTip="退出多选模式">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8BB;" FontSize="13"/>
                                <TextBlock Text="退出多选" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 查找重复命令条：只有进了"查找重复"模式才出现 -->
                <Border x:Name="DupBar"
                        Grid.Row="1"
                        Background="#FF202020"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="0,0,0,1"
                        Padding="12,7"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- 模式切换：精确重复（MD5）/ 相似（PHash） -->
                        <ToggleButton x:Name="DupExactToggle"
                                      Content="精确重复"
                                      Checked="DupExactToggle_Checked"
                                      Unchecked="DupExactToggle_Unchecked"/>
                        <ToggleButton x:Name="DupSimilarToggle"
                                      Content="相似图片"
                                      Checked="DupSimilarToggle_Checked"
                                      Unchecked="DupSimilarToggle_Unchecked"/>
                        <Button x:Name="DupDeleteButton"
                                Click="DupDeleteButton_Click"
                                ToolTipService.ToolTip="把没标「保留」的图移到回收站（可在资源管理器里还原）">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                <TextBlock Text="未保留的移到回收站" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="DupStatusText"
                                   Text="" FontSize="12"
                                   Foreground="#A6FFFFFF"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="DupExitButton"
                                HorizontalAlignment="Right"
                                Click="DupExitButton_Click"
                                ToolTipService.ToolTip="退出查找重复">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8BB;" FontSize="13"/>
                                <TextBlock Text="退出" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 缩略图墙 -->
                <ScrollViewer x:Name="GridScroller"
                              Grid.Row="2"
                              Padding="10,0,10,10"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollMode="Auto"
                              ContextRequested="Wall_ContextRequested">
                    <ItemsRepeater x:Name="Thumbs"
                                  ItemTemplate="{StaticResource TileTemplate}"
                                  ElementPrepared="Thumbs_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <!--
                              UniformGridLayout 是关键：它会真正回收屏幕外的格子
                              （GridView 的虚拟化在 WinUI3 里有已知问题）。
                              只解看得见的那几张，才撑得住上万张的目录。
                            -->
                            <UniformGridLayout MinItemWidth="180"
                                               MinItemHeight="180"
                                               MinColumnSpacing="6"
                                               MinRowSpacing="6"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

                <!--
                  查找重复结果：进入该模式才显示，平时隐藏（和上面的主墙 GridScroller 共用 Grid.Row=2，
                  靠 Visibility 互斥）。里面是一组一组的缩略图，由代码往 DupGroups 里填。
                -->
                <ScrollViewer x:Name="DupPanel"
                              Grid.Row="2"
                              Padding="16,12,16,12"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel x:Name="DupGroups" Spacing="6"/>
                </ScrollViewer>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyState"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="#33FFFFFF"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyText" Text="从左边选一个文件夹" FontSize="14"
                               Foreground="#77FFFFFF" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 状态栏 -->
                <Border Grid.Row="3" Background="#FF181818" Padding="16,7"
                        BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="11"
                                   Foreground="#77FFFFFF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="CacheText" Grid.Column="1" FontSize="11"
                                   Foreground="#55FFFFFF"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

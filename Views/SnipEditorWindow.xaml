<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteGallery.Views.SnipEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CelesteGallery 截图">

    <!--
      截图第二步：标注编辑器。

      进到这里的时候，画面已经被裁成用户选中的那一块了。
      左边一排是笔，右边是存/复制这类收尾动作，中间就是图。

      一个刻意的决定：标注是**直接画进像素**的（画完立刻刷新位图），
      不是"贴在上一层透明的 XAML 图形"。理由和项目里 PhotoMark 一样——
      所见即所得，导出的时候不需要再做一次合成，屏幕上看到的和存出来的一模一样。
    -->
    <Grid x:Name="Root" Background="#FF1C1C1C" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 工具条 ===== -->
        <Border Grid.Row="0" Background="#FF242424" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左边的笔：横向可滚，窗口窄的时候不至于挤成一团 -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="3">

                        <!-- 工具按钮由代码按 SnipTool 逐个生成，塞进这个容器。
                             之所以不在 XAML 里写死九个按钮：每个按钮的"选中态"要跟着
                             当前工具变，用代码生成可以共用同一套样式和点击处理。 -->
                        <StackPanel x:Name="ToolBar" Orientation="Horizontal" Spacing="3"/>

                        <Border Width="1" Background="#26FFFFFF" Margin="5,2"/>

                        <!-- 颜色：八个常用色 + 一个"当前色"预览 -->
                        <StackPanel x:Name="ColorBar" Orientation="Horizontal" Spacing="3"
                                    VerticalAlignment="Center"/>

                        <Border x:Name="CurrentColorChip" Width="24" Height="24" CornerRadius="4"
                                BorderBrush="#59FFFFFF" BorderThickness="1" Margin="4,0,2,0"
                                VerticalAlignment="Center" ToolTipService.ToolTip="当前颜色"/>

                        <Border Width="1" Background="#26FFFFFF" Margin="5,2"/>

                        <!-- 粗细 -->
                        <TextBlock Text="粗细" FontSize="12" Foreground="#99FFFFFF"
                                   VerticalAlignment="Center" Margin="2,0,4,0"/>
                        <Slider x:Name="WidthSlider" Width="92" Minimum="1" Maximum="24" StepFrequency="1"
                                Value="3" VerticalAlignment="Center"
                                ValueChanged="WidthSlider_ValueChanged"/>
                        <TextBlock x:Name="WidthText" Text="3" FontSize="12" Foreground="#CCFFFFFF"
                                   Width="18" VerticalAlignment="Center" TextAlignment="Right"/>

                        <Border Width="1" Background="#26FFFFFF" Margin="5,2"/>

                        <Button x:Name="UndoButton" Click="UndoButton_Click" Padding="8,5"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="撤销上一步（Ctrl+Z）">
                            <TextBlock Text="撤销" FontSize="12.5" Foreground="#DCE2E2E2"/>
                        </Button>
                        <Button x:Name="ClearButton" Click="ClearButton_Click" Padding="8,5"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="清除全部标注">
                            <TextBlock Text="清除" FontSize="12.5" Foreground="#DCE2E2E2"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 右边的收尾动作 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="3">
                    <Button x:Name="PickColorButton" Click="PickColorButton_Click" Padding="9,5"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="从图上取一个颜色当画笔颜色">
                        <TextBlock Text="取色" FontSize="12.5" Foreground="#DCE2E2E2"/>
                    </Button>
                    <Button x:Name="OcrButton" Click="OcrButton_Click" Padding="9,5"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="认出图上的文字">
                        <TextBlock Text="识别文字" FontSize="12.5" Foreground="#DCE2E2E2"/>
                    </Button>
                    <Button x:Name="CopyButton" Click="CopyButton_Click" Padding="11,5"
                            ToolTipService.ToolTip="复制到剪贴板，可以直接粘贴到聊天窗口">
                        <TextBlock Text="复制" FontSize="12.5" Foreground="#DCE2E2E2"/>
                    </Button>
                    <Button x:Name="SaveButton" Click="SaveButton_Click" Padding="11,5"
                            Background="#3A6EA5" ToolTipService.ToolTip="另存为图片文件">
                        <TextBlock Text="保存" FontSize="12.5" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 画布 ===== -->
        <Grid Grid.Row="1" Background="#FF141414">
            <!--
              Stage 是"图 + 覆盖层"的容器，尺寸严格等于图的显示尺寸。
              鼠标坐标换算全靠它：Pointer 事件拿到的位置是相对 Stage 的，
              除以 _viewScale 就是图像像素坐标。
            -->
            <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="ViewImage" Stretch="Fill"/>

                <!-- 拖拽过程中的预览（矩形/椭圆/箭头这些），松手就消失，真正画进像素 -->
                <Canvas x:Name="Overlay" IsHitTestVisible="False"/>

                <!-- 正在输入文字时的输入框 -->
                <TextBox x:Name="TextInput" Visibility="Collapsed" MinWidth="120"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Background="#F2202020" Foreground="White" BorderBrush="#FF2E9BFF"
                         FontSize="16" AcceptsReturn="False"/>

                <!-- 取色器：跟着鼠标飘的小方块，显示指针底下那个点的颜色 -->
                <Border x:Name="PickerTip" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="74" Height="30" Background="#E6000000" CornerRadius="5"
                        BorderBrush="#59FFFFFF" BorderThickness="1" Padding="5,3">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border x:Name="PickerSwatch" Width="20" Height="20" CornerRadius="3"/>
                        <TextBlock x:Name="PickerHex" FontSize="11" Foreground="White"
                                   VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 识别文字的结果 -->
            <Border x:Name="OcrPanel" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Width="300" Background="#F21E1E1E" BorderBrush="#26FFFFFF" BorderThickness="1,0,0,0">
                <Grid Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="识别结果" FontSize="14" Foreground="White" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Click="OcrClose_Click" Padding="6,2"
                                Background="Transparent" BorderThickness="0">
                            <TextBlock Text="✕" FontSize="13" Foreground="#99FFFFFF"/>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <TextBlock x:Name="OcrText" FontSize="13" Foreground="#E6FFFFFF"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </ScrollViewer>
                    <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                            Click="OcrCopy_Click">
                        <TextBlock Text="复制全部文字" FontSize="12.5"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部状态条 ===== -->
        <Border Grid.Row="2" Background="#FF242424" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="#8CFFFFFF"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="HintText" FontSize="11.5" Foreground="#66FFFFFF"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>

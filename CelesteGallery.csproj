<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      ===== 统一 net9 =====
      原因：WindowsAppSDK 2.4.0 里的 WinRT.Runtime 2.3.1 要求 System.Runtime 9.0.0.0，
      net8 项目只提供 8.0.0.0，会报 CS1705（在 CelesteVideoPlayer 上实测踩到）。
      三个 Celeste 项目（Music / Viewer / VideoPlayer）统一到 net9。

      平台版本用 26100 而不是模板默认的 19041：
      本机实际装的 Windows SDK 只有 22621 / 26100 / 28000，没有 19041，
      填 19041 在命令行构建时会报 "Could not read the Windows SDK's Platform.xml"。
    -->
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <RootNamespace>CelesteGallery</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>

    <!--
      版本号：关于窗口直接读它显示，改版本只改这一处。
      日期式版本（26.9.13 = 2026 年 9 月 13 日），和 CelesteMusicPlayer 那边的习惯一致。
    -->
    <Version>26.9.14.0</Version>

    <!--
      ===== MSIX 打包工具链：关掉 =====
      本程序走"恒定非打包"运行（见下面 WindowsPackageType=None）。
      单项目 MSIX 打包工具链只剩下副作用：它会让 VS 的设计时构建多跑一整套
      AppX / PRI 相关的 target，那正是 "WMC9999 Invalid metadata token Module(0x0)"
      这类设计时报错的温床（命令行构建一直是干净的，只有 VS 里会）。
      这一段是从 CelesteMediaPlayer 原样搬过来的，那边的坑在这边一样会踩。
    -->
    <EnableMsixTooling>false</EnableMsixTooling>

    <!--
      ===== 非打包运行（让 exe 能被双击、能被图片文件关联直接拉起）=====
      WindowsAppSdkDeploymentManagerInitialize=false 是必须的：
      非打包模式下它默认开启，启动时先去"自动部署 Windows App Runtime"，
      找不到对应 COM 注册（DDLM 包）就直接抛 0x80040154「没有注册类」，进程秒退。
      表现就是"右键用本程序打开图片，完全没反应"。
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>

  <!--
    主项目刻意不设 RuntimeIdentifier：
    XamlCompiler 对输出路径很敏感，加上 RID 会多出一层 win-x64 目录，
    有概率触发它崩。native 库复制的事交给 CelesteGallery.Core 自己处理。
  -->

  <!--
    ===== 程序图标 =====

    ApplicationIcon 决定 exe 自己的图标（资源管理器里看到的、任务栏钉住的）——
    这是唯一能改 exe 图标的地方，运行时改不了。
    窗口左上角那个小图标和任务栏图标是另一回事，靠 MainWindow 里的 AppWindow.SetIcon。

    AppIcon.png 要给标题栏用（Image 控件的 Source），所以必须复制到输出目录；
    ico 也是，因为 SetIcon 是读文件路径的。
    风格和 CelesteMusicPlayer 保持一致：圆角方形 + 青蓝垂直渐变 + 白色图形。

    TitleMark.png 是**标题栏专用的另一版图案**（单张相框、纯白、无蓝）：
    主图标那套"三张照片叠影 + 渐变"是为大尺寸（桌面 / 任务栏）设计的，
    缩到标题栏的 16 逻辑像素只剩一坨浅色，所以标题栏单走一张图。
    两张图都是同一个生成脚本的兄弟产物（icon_build\make_title_mark.py）。
  -->
  <PropertyGroup>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\AppIconSource.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\TitleMark.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <!--
    解码、缩略图、EXIF 全部放在 CelesteGallery.Core 类库里。

    为什么非要拆出去：Magick.NET 会把它的 native 解码库塞进 MSBuild 的 items 列表，
    而 WinUI 的 XamlCompiler 一看到不认识的 item 就直接崩（报 output.json was not created
    或 WMC9999）。在 CelesteMediaPlayer 那边，让 .ico 进 items 时踩过一模一样的坑。
    放进类库之后，那些 items 只存在于类库内部，主项目的 XamlCompiler 看不见。
  -->
  <ItemGroup>
    <ProjectReference Include="CelesteGallery.Core\CelesteGallery.Core.csproj" />
  </ItemGroup>

  <!--
    ===== 必须排除：CelesteGallery.Core 是本项目的子目录 =====

    SDK 默认的源码通配是 `**/*.cs`，而它只排除"本项目自己的" obj\ 和 bin\。
    CelesteGallery.Core 是主项目目录下的**子目录**，不在排除范围内，于是：

      1. Core 的源码被主项目又编译了一遍 → 同一批类型在
         CelesteGallery.dll 和 CelesteGallery.Core.dll 里各存在一份
      2. 更糟的是 Core 的 obj\ 生成物（CelesteGallery.Core.AssemblyInfo.cs）也一起
         被编译进来 → 与主项目自己的 AssemblyInfo.cs 撞车，
         报一堆 CS0579「特性重复」（AssemblyCompanyAttribute 等）

    这个坑很阴：全量清理后第一次构建是好的（通配在 obj 生成之前就定型了），
    第二次构建才炸 —— 排查时极易误判成项目配置坏了。

    Debug 和 Release 都要有，所以这里不限定 Configuration。
  -->
  <ItemGroup>
    <Compile Remove="CelesteGallery.Core\**\*.cs" />
    <None Remove="CelesteGallery.Core\**" />
    <Content Remove="CelesteGallery.Core\**" />
    <Page Remove="CelesteGallery.Core\**" />
    <PRIResource Remove="CelesteGallery.Core\**" />
    <EmbeddedResource Remove="CelesteGallery.Core\**" />
    <ApplicationDefinition Remove="CelesteGallery.Core\**" />
    <Manifest Remove="CelesteGallery.Core\**" />
  </ItemGroup>

  <!--
    ===== 同样必须排除 tools\ =====

    tools\IndexHarness 是一个独立的可执行验证工具（有自己的 csproj 和 Main）。
    主项目的源码通配是 **/*.cs，不排除的话它会把 IndexHarness 的 Program.cs
    也一起编译进来 —— 于是主程序里多出一个 Main，和 WinUI 的入口打架。

    和上面 CelesteGallery.Core 那段是同一个坑的不同版本：只要往主项目目录里
    放了"另一个项目"，就必须在这里加一条排除。
  -->
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <None Remove="tools\**" />
    <Content Remove="tools\**" />
    <Page Remove="tools\**" />
    <PRIResource Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <ApplicationDefinition Remove="tools\**" />
    <Manifest Remove="tools\**" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>

    <!--
      裁剪（PublishTrimmed）只在"自包含"发布下有效；框架依赖发布开它会直接报
      NETSDK1102（所选发布配置不支持优化程序集的大小）。

      第一版安装包走**框架依赖**（和 CelesteMusicPlayer 一致：装完体积小，
      缺 .NET 9 运行时由安装程序提示用户去装）。所以这里按 SelfContained 自动决定，
      将来哪天要发自包含版本，命令行加上 -p:SelfContained=true 即可，不用再改这个文件。
    -->
    <PublishTrimmed Condition="'$(SelfContained)' != 'true'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug' and '$(SelfContained)' == 'true'">True</PublishTrimmed>
  </PropertyGroup>

  <!--
    ===== 发布时把 PRI 资源索引补进发布目录 =====

    背景：本项目关掉了 MSIX 工具链（见上面 EnableMsixTooling 的说明，那是为了避开
    VS 设计时构建的 WMC9999），代价是 AppX / PRI 那一整套 target 也不再跑 ——
    而"把 *.pri 加进待发布列表"正是它们干的活。

    后果极其隐蔽：dotnet publish **不报任何错**，产物看着也齐全（128MB / 56 个文件），
    但发布目录里根本没有 CelesteGallery.pri。装到机器上一点开就死在 MainWindow 的
    LoadComponent —— XAML 资源全部索引不到，日志只有一句 0x80004005，看不出跟资源有关。
    （Debug 构建能跑，所以开发时完全发现不了；只有真正走发布流程才会暴露。）

    实测（2026-09-14）：
      Debug / Release build 输出目录 → 有 CelesteGallery.pri，能跑
      Release publish 目录          → 一个 .pri 都没有，必崩
      手工把 CelesteGallery.pri 复制进发布目录 → 立刻恢复正常（存活，致命错误 0 条）
      对照 CelesteMusicPlayer 的发布目录 → 它也只有 <App>.pri、没有 xbf 散文件，
      说明 xbf 已经被索引进 pri 里了，不需要单独复制 xbf。

    修法：编译阶段 pri 已经躺在 $(OutDir) 里了，这里在 publish 收尾补一次复制。
    只复制 $(MSBuildProjectName).pri（本应用自己的资源索引）——
    Microsoft.UI.pri / Microsoft.WindowsAppRuntime.pri 那几个在框架依赖模式下
    由 Windows App Runtime 的 MSIX 包提供，本地再放一份反而可能跟包版本打架。

    自包含发布（-p:SelfContained=true）时同样需要这个，所以不加条件。
  -->
  <Target Name="CelesteCopyPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(MSBuildProjectName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)$(MSBuildProjectName).pri')" />
    <Message Importance="high"
             Text="CelesteGallery: PRI 资源索引已补入发布目录 → $(PublishDir)"
             Condition="Exists('$(OutDir)$(MSBuildProjectName).pri')" />
    <Warning Text="CelesteGallery: 找不到 $(OutDir)$(MSBuildProjectName).pri —— 发布产物会缺 XAML 资源索引，装上去启动即崩，请检查构建是否完整。"
             Condition="!Exists('$(OutDir)$(MSBuildProjectName).pri')" />
  </Target>
</Project>